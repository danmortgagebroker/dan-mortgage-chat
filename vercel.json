{
  "trailingSlash": true,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/kb",
      "destination": "/kb/index.html"
    },
    {
      "source": "/kb/",
      "destination": "/kb/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    }
  ]
}
